{
  "name": "takeone-axi",
  "version": "0.5.2",
  "description": "Turn a raw screen recording into a polished demo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/takeone.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "takeone": "./bin/takeone.mjs",
    "takeone-axi": "./bin/takeone.mjs"
  },
  "files": [
    "bin",
    "dist",
    "resources",
    "scripts/synth-take.ts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.ts dist/test/*.test.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "quality": "node scripts/quality.ts"
  },
  "dependencies": {
    "@byokit/accounts": "0.30.0",
    "@byokit/decide": "^0.15.0",
    "@byokit/secrets": "0.5.2",
    "@desklink/host": "0.5.3",
    "three": "0.149.0",
    "werift": "0.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}

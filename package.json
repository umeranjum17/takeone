{
  "name": "takeone",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a raw screen recording into a polished demo.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "takeone": "./bin/takeone.mjs"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.ts dist/test/*.test.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "quality": "node scripts/quality.ts"
  },
  "dependencies": {
    "@byokit/decide": "0.4.3",
    "@byokit/secrets": "0.3.0",
    "@desklink/host": "0.1.0",
    "werift": "0.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}
